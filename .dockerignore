# `**/` so nested trees are excluded too. Dockerfile.seeder installs
# scripts/ dependencies in an early layer and then copies scripts/ over it — a
# host-side scripts/node_modules in the context would overwrite the image's
# Linux build with whatever the developer's machine produced.
**/node_modules
dist
.git
.github
.windsurf
.agent
.agents
.claude
.factory
.planning
e2e
src-tauri/target
src-tauri/sidecar/node
*.log
# Local self-hosting credentials must not enter Docker build contexts or caches.
docker-compose.override.yml
secrets/
*.md
!README.md
!CHANGELOG.md
docs/internal
docs/Docs_To_Review
tests
