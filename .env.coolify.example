# =============================================================================
# World Monitor — Coolify environment variables
# =============================================================================
# Paste these into the Coolify resource's "Environment Variables" tab, not into
# a file in the repo. Coolify feeds them to docker-compose.coolify.yml.
#
# Only the three secrets in the REQUIRED block are mandatory. Everything below
# it is optional — each missing key disables exactly the panel that needs it,
# and the rest of the dashboard keeps working.
#
# Variables marked [BUILD] are consumed by Vite at build time. Changing one
# needs a Coolify "Redeploy" (rebuild), not a restart. In the Coolify UI they
# must be marked as "Build Variable" as well.
# =============================================================================


# =============================================================================
# REQUIRED — the stack will not start without these
# =============================================================================
# Generate each one separately:  openssl rand -hex 32
# On Windows PowerShell:
#   -join ((1..32) | % { '{0:x2}' -f (Get-Random -Max 256) })

# The values below are deliberately fake placeholders of the right LENGTH
# (64 hex chars). Replace all three with independently generated secrets —
# reusing one value for two variables gives an attacker who learns the REST
# token the Redis password for free.

# Redis AUTH password. The redis container refuses to start without it and the
# REST proxy uses it in its upstream connection string.
REDIS_PASSWORD=CHANGEME0000000000000000000000000000000000000000000000000000c0de

# Bearer token the REST proxy requires on every request. This is also what the
# app and seeders send as UPSTASH_REDIS_REST_TOKEN.
REDIS_TOKEN=CHANGEME0000000000000000000000000000000000000000000000000000face

# Authenticates every non-public request the dashboard makes to the AIS relay.
# The relay calls process.exit(1) at boot when this is unset.
RELAY_SHARED_SECRET=CHANGEME0000000000000000000000000000000000000000000000000000beef


# =============================================================================
# BUILD-TIME FRONTEND CONFIG  [BUILD]
# =============================================================================

# Which dashboard to build: full | tech | finance | commodity | energy | happy
VITE_VARIANT=full

# Map interaction: "3d" allows pitch/rotation, "flat" locks to 2D
VITE_MAP_INTERACTION_MODE=3d

# Client-side Sentry DSN. Empty disables browser error reporting.
VITE_SENTRY_DSN=

# Self-hosted PMTiles basemap. Empty falls back to free OpenFreeMap tiles.
# Example: https://tiles.yourdomain.com/planet.pmtiles
VITE_PMTILES_URL=

# Only set this if the API lives on a different host than the dashboard.
# Leave empty for this stack — nginx serves /api/* from the same origin.
VITE_WS_API_URL=


# =============================================================================
# AI / LLM — powers intelligence assessments and summaries
# =============================================================================

# Groq — free tier, 14,400 req/day. https://console.groq.com
GROQ_API_KEY=gsk_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# OpenRouter fallback — free tier, 50 req/day. https://openrouter.ai
OPENROUTER_API_KEY=sk-or-v1-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Or point at any OpenAI-compatible endpoint instead (Ollama, vLLM, llama.cpp).
# If the endpoint runs on the Coolify host itself, use the container-reachable
# address, not 127.0.0.1 — that resolves inside the container.
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=


# =============================================================================
# MARKETS & ECONOMICS
# =============================================================================

# Finnhub — stock quotes. Free tier. https://finnhub.io
FINNHUB_API_KEY=XXXXXXXXXXXXXXXXXXXXXXXX

# FRED — Federal Reserve economic data. Free.
# https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# EIA — US energy prices, production, inventory. Free.
# https://www.eia.gov/opendata/
EIA_API_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX


# =============================================================================
# CONFLICT & UNREST
# =============================================================================

# ACLED — free for researchers. https://acleddata.com
# Prefer the email/password pair: tokens auto-refresh. The static
# ACLED_ACCESS_TOKEN expires every 24h and is only a fallback.
ACLED_EMAIL=you@example.com
ACLED_PASSWORD=your-acled-password
ACLED_ACCESS_TOKEN=

# UCDP — Uppsala Conflict Data Program. Optional; public endpoints work without.
UCDP_ACCESS_TOKEN=


# =============================================================================
# EARTH OBSERVATION & CLIMATE
# =============================================================================

# NASA FIRMS — satellite wildfire detection. Required for the fire panel. Free.
# https://firms.modaps.eosdis.nasa.gov
NASA_FIRMS_API_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ReliefWeb requires a self-identifying app name on every request.
RELIEFWEB_APPNAME=worldmonitor-selfhost

# Air quality. Both free. https://openaq.org · https://aqicn.org/data-platform/token/
OPENAQ_API_KEY=
WAQI_API_KEY=


# =============================================================================
# AVIATION & MARITIME
# =============================================================================

# AISStream — live vessel positions over WebSocket. Free. https://aisstream.io
AISSTREAM_API_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# OpenSky — flight tracking. Works anonymously; an account raises rate limits.
# https://opensky-network.org
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# AviationStack — flight status. Free tier. https://aviationstack.com
AVIATIONSTACK_API=

# Wingbits — aircraft owner/operator/type enrichment. https://wingbits.com
WINGBITS_API_KEY=

# Travelpayouts — flight price search. https://travelpayouts.com
TRAVELPAYOUTS_API_TOKEN=


# =============================================================================
# INTERNET OUTAGES  (paid)
# =============================================================================

# Cloudflare Radar. Requires a Cloudflare account with Radar access.
CLOUDFLARE_API_TOKEN=


# =============================================================================
# PROCUREMENT & OSINT  (optional)
# =============================================================================

# SAM.gov — US federal contract awards. Free. https://sam.gov/data-services
SAM_GOV_API_KEY=

# Telegram OSINT channel polling in the relay. Generate TELEGRAM_SESSION with:
#   node scripts/telegram/session-auth.mjs
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=


# =============================================================================
# OPERATIONS — tuning knobs, all have working defaults
# =============================================================================

# How often the seeder container re-runs all 163 seeders, in minutes.
# Below ~15 you start tripping upstream rate limits.
SEED_INTERVAL_MINUTES=30

# Wall-clock cap per standalone seeder, in seconds. 0 disables it.
SEED_TIMEOUT=1800

# Relay market-quote refresh cadence, in milliseconds (default 15 min).
MARKET_YAHOO_REFRESH_INTERVAL_MS=900000

# Redis data budget. Keep WM_REDIS_MEMORY comfortably above this — client
# buffers and the AOF rewrite buffer live on top of the dataset.
REDIS_MAXMEMORY=768mb

# Per-container resource ceilings. Defaults suit a 4 vCPU / 8 GB node.
WM_APP_CPUS=2.0
WM_APP_MEMORY=1g
WM_RELAY_CPUS=1.5
WM_RELAY_MEMORY=2g
WM_SEEDER_CPUS=2.0
WM_SEEDER_MEMORY=2g
WM_REDIS_CPUS=1.0
WM_REDIS_MEMORY=1g
WM_REST_CPUS=0.5
WM_REST_MEMORY=256m
