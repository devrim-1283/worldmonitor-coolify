# =============================================================================
# World Monitor — Seeder Runner
# =============================================================================
# The dashboard reads everything from Redis; `scripts/seed-*.mjs` are what put
# it there. Upstream leaves that to a host-side cron calling
# `scripts/run-seeders.sh` (see SELF_HOSTING.md), which does not exist on a
# Coolify host. This image runs the same script on a loop inside the stack.
#
# No root `npm ci`. Walking the import graph of all 163 seeders (339 files,
# reaching 4 modules under server/ and 2 under api/) turns up exactly seven
# external packages — @aws-sdk/client-s3, exceljs, fast-xml-parser, papaparse,
# resend, sax, yaml — and every one is already in scripts/package.json.
# scripts/_seed-history.mjs states the same invariant: seeders may import
# "scripts/, node:*, and bare packages in scripts/package.json". Installing the
# root production graph on top of that added 2 GB of browser-only payload
# (onnxruntime-web, @arcgis, maplibre-gl, three, react-native) that no seeder
# can reach.
# =============================================================================

FROM node:24-alpine@sha256:a0b9bf06e4e6193cf7a0f58816cc935ff8c2a908f81e6f1a95432d679c54fbfd

# curl — a few upstreams (OREF, Akamai-fronted feeds) reject Node's TLS
# fingerprint and are fetched by shelling out to curl.
# coreutils — run-seeders.sh wraps each standalone seeder in `timeout -k` and
# classifies on the 124/137 exit codes; BusyBox's applet differs there.
# tini — reaps the seeder child processes the loop spawns.
RUN apk add --no-cache curl coreutils tini && \
    addgroup -S seeder && adduser -S seeder -G seeder

WORKDIR /app
RUN chown seeder:seeder /app

# Install and copy as the runtime user. A trailing `chown -R /app` would be the
# obvious alternative, but it rewrites every inode and Docker stores the result
# as a second full copy of node_modules — 1.8 GB of duplicate layer.
USER seeder

COPY --chown=seeder:seeder scripts/package.json scripts/package-lock.json ./scripts/
# --ignore-scripts keeps node-gyp-build out of the picture: ws/telegram's
# native helpers (bufferutil, utf-8-validate) fall back to pure JS, so Alpine
# needs no Python/build toolchain. Mirrors Dockerfile.relay.
RUN npm ci --prefix scripts --omit=dev --omit=optional --ignore-scripts

# Source. scripts/ lands on top of the install above; .dockerignore's
# **/node_modules is what keeps a developer's host-built scripts/node_modules
# from overwriting the Linux tree installed here.
COPY --chown=seeder:seeder scripts/ ./scripts/
COPY --chown=seeder:seeder shared/ ./shared/
COPY --chown=seeder:seeder server/ ./server/
COPY --chown=seeder:seeder api/ ./api/
COPY --chown=seeder:seeder data/ ./data/
COPY --chown=seeder:seeder tsconfig.json ./

COPY --chown=seeder:seeder docker/seeder-loop.sh docker/seeder-healthcheck.sh ./
# A Windows checkout can drop the exec bit even with .gitattributes pinning EOL.
RUN chmod +x seeder-loop.sh seeder-healthcheck.sh scripts/run-seeders.sh

# Node 24 strips TypeScript natively, so the seeders that import server/*.ts
# run under plain `node` without a loader flag.
ENV NODE_OPTIONS=--dns-result-order=ipv4first

# Liveness: the loop touches a heartbeat file after every pass. A run that
# wedges past two intervals stops refreshing it and the container is restarted.
# start-period is generous — a cold first pass over 163 seeders is slow.
HEALTHCHECK --interval=60s --timeout=15s --start-period=45m --retries=3 \
  CMD /app/seeder-healthcheck.sh

ENTRYPOINT ["/sbin/tini", "--"]
CMD ["/app/seeder-loop.sh"]
